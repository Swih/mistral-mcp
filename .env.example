# Copy to .env and fill in. Never commit .env.

# Mistral Cloud API key. Required unless MISTRAL_BASE_URL points at an endpoint
# that does not authenticate.
MISTRAL_API_KEY=

# --- Self-hosted inference -------------------------------------------------
# Any OpenAI-compatible endpoint (vLLM, TGI, LiteLLM, an internal gateway).
# Setting this switches the server to the `self-hosted` profile, which registers
# only the tools such an endpoint can serve. See deploy/README.md.
# MISTRAL_BASE_URL=http://vllm.internal:8000/v1

# Default chat model when a call omits `model`. With a custom endpoint this is
# usually your own identifier, not a Mistral alias.
# MISTRAL_DEFAULT_MODEL=mistral-medium-latest

# core (default) | admin | workflows | metier-docs | self-hosted
# An explicit value always overrides what MISTRAL_BASE_URL would infer.
# MISTRAL_MCP_PROFILE=core

# Set to `off` to silence the per-tool-call JSON audit line on stderr.
# MISTRAL_MCP_AUDIT=

# Where process_document caches OCR + extraction results.
# MISTRAL_MCP_CACHE_DIR=/var/cache/mistral-mcp

# How long a cached extraction may be reused, in hours. Default 168 (7 days).
# The cache holds extracted document content, which is personal data, so it is
# a retention policy rather than a performance knob. Set 0 to disable reuse.
# MISTRAL_MCP_CACHE_TTL_HOURS=168

# --- Streamable HTTP transport ---------------------------------------------
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3333
# MCP_HTTP_PATH=/mcp
# Bearer token clients must present. Generate: openssl rand -hex 32
# MCP_HTTP_TOKEN=
# Comma-separated exact origins. Set when browser-based clients reach the server.
# MCP_HTTP_ALLOWED_ORIGINS=
